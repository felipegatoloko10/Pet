# Copiar para apps/web/.env.local. Nunca commitar valores reais.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Certificado CA oficial do projeto Supabase (PEM) para validação TLS completa
DATABASE_SSL_CA=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# A autenticação é do Pingo (Better Auth), sem Google ou servidor SMTP.
# 32 bytes em base64; usado somente no servidor
CREDENTIAL_ENCRYPTION_KEY=
INVITE_ADMIN_EMAIL=
SCHEDULER_SECRET=
SCHEDULER_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Desktop: apps/desktop/.env.local
# VITE_API_URL=https://seu-pingo.vercel.app
# Android: lembretes locais, sem Firebase/FCM.
