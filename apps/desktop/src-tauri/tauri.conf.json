{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingo",
  "version": "2.4.0-beta.1",
  "identifier": "app.pingo.companion",
  "plugins": { "deep-link": { "desktop": { "schemes": ["pingo"] } } },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pingo — meu dia",
        "width": 1250,
        "height": 850,
        "minWidth": 390,
        "minHeight": 600
      },
      {
        "label": "pet",
        "title": "Pingo",
        "url": "index.html?pet=1",
        "width": 360,
        "height": 500,
        "minWidth": 280,
        "minHeight": 360,
        "maxWidth": 650,
        "maxHeight": 860,
        "transparent": true,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://pingo-gilt.vercel.app https://*.vercel.app; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"]
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
