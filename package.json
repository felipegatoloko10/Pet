{
  "name": "pingo",
  "version": "2.6.0-beta.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pingo/web",
    "build": "npm run build -w @pingo/web && npm run build -w @pingo/desktop",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "desktop": "npm run tauri -w @pingo/desktop",
    "mobile:build": "npm run build -w @pingo/mobile && npm run sync -w @pingo/mobile",
    "invite": "tsx scripts/invite.ts",
    "test:browser": "playwright test",
    "test:backend": "tsx scripts/verify-backend.ts",
    "test:scheduler": "node scripts/verify-scheduler.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/openai": "latest",
    "@date-fns/tz": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-notification": "latest",
    "@tauri-apps/plugin-opener": "latest",
    "@tauri-apps/plugin-sql": "latest",
    "@tauri-apps/plugin-stronghold": "latest",
    "@vercel/functions": "latest",
    "@vercel/oidc": "4.0.3",
    "ai": "7.0.149",
    "better-auth": "1.7.12",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.0",
    "idb": "^8.0.0",
    "lucide-react": "latest",
    "next": "16.4.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@tauri-apps/cli": "latest",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "drizzle-kit": "latest",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "type": "module"
}
