{
  "identifier": "desktop",
  "description": "Permissões locais das duas janelas do Pingo.",
  "windows": ["main", "pet"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://pingo-gilt.vercel.app/**" },
        { "url": "https://accounts.google.com/**" },
        { "url": "https://mail.google.com/**" }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "notification:default"
  ]
}
