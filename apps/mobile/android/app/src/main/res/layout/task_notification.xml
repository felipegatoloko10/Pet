<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="vertical" android:background="#eaf5f0">
 <TextView android:id="@+id/task_title" android:layout_width="match_parent" android:layout_height="18dp" android:singleLine="true" android:ellipsize="end" android:textStyle="bold" android:textSize="12sp" android:textColor="@android:color/primary_text_light" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
  <TextView android:id="@+id/status_pending" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="A fazer" android:textSize="11sp" android:textStyle="bold" android:textColor="#235e4a" android:background="@drawable/notification_action" android:layout_marginEnd="3dp" android:contentDescription="A fazer" />
<TextView android:id="@+id/status_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Fazendo" android:textSize="11sp" android:textStyle="bold" android:textColor="#235e4a" android:background="@drawable/notification_action" android:layout_marginEnd="3dp" android:contentDescription="Fazendo" />
<TextView android:id="@+id/status_waiting" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Aguardar" android:textSize="11sp" android:textStyle="bold" android:textColor="#235e4a" android:background="@drawable/notification_action" android:layout_marginEnd="3dp" android:contentDescription="Aguardar" />
<TextView android:id="@+id/status_complete" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Concluir" android:textSize="11sp" android:textStyle="bold" android:textColor="#235e4a" android:background="@drawable/notification_action" android:layout_marginEnd="3dp" android:contentDescription="Concluir" />
 </LinearLayout>
</LinearLayout>
