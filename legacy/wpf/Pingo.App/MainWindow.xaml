<Window x:Class="Pingo.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pingo.Desktop" Title="Pingo · um dia de cada vez" Width="1100" Height="790" MinWidth="950" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="HideWindow">
 <Grid Background="#F7F7FB" TextElement.Foreground="#242237">
  <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#ECEAF3" BorderThickness="0,0,1,0">
   <DockPanel Margin="22,28,22,22">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,36"><StackPanel Orientation="Horizontal"><Border Background="#D8F4E8" CornerRadius="12" Width="34" Height="34"><TextBlock Text="p" FontSize="25" FontWeight="Bold" Foreground="#399C7E" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="pingo" FontSize="25" FontWeight="Bold" Margin="10,-1,0,0"/></StackPanel><TextBlock Text="SEU DIA, MAIS LEVE" FontSize="9" Foreground="#A09BAF" Margin="0,13,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="#F5F3FA" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="Um passo de cada vez." FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Eu cuido dos lembretes. Você cuida do que importa." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="AccountLabel" Text="○  Modo local" FontSize="11" Foreground="#878195" Margin="8,18,0,0" TextTrimming="CharacterEllipsis" MaxHeight="32"/></StackPanel>
    <StackPanel><Button x:Name="NavHome" Tag="Hoje" Content="◷    Meu dia" Style="{StaticResource Nav}" Click="Navigate"/><Button x:Name="NavTasks" Tag="Tarefas" Content="✓    Tarefas" Style="{StaticResource Nav}" Click="Navigate"/><Button x:Name="NavCalendar" Tag="Agenda" Content="▦    Agenda" Style="{StaticResource Nav}" Click="Navigate"/><Button x:Name="NavMail" Tag="E-mails" Content="✉    E-mails" Style="{StaticResource Nav}" Click="Navigate"/><Button x:Name="NavActivity" Tag="Avisos" Content="♧    Avisos" Style="{StaticResource Nav}" Click="Navigate"/><Border Height="1" Background="#F0EDF5" Margin="6,20"/><Button x:Name="NavSettings" Tag="Ajustes" Content="⚙    Ajustes" Style="{StaticResource Nav}" Click="Navigate"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="＋  Compromisso" Style="{StaticResource Primary}" Click="CreateEvent" Margin="12,3,0,0" VerticalAlignment="Top"/><StackPanel><TextBlock x:Name="DateLabel" Text="QUARTA-FEIRA, 21 DE OUTUBRO" FontSize="10" Foreground="#938BA4"/><TextBlock x:Name="PageTitle" Text="Seu dia começa aqui." Foreground="#242237" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" x:Name="InfoBanner" Background="#EFEBF9" CornerRadius="10" Padding="13,9" Margin="0,0,0,16"><DockPanel><TextBlock Text="●" Foreground="#8B72CC" Margin="0,0,9,0"/><TextBlock x:Name="InfoText" Text="" FontSize="12" Foreground="#786493"/></DockPanel></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel x:Name="ContentPanel"/></ScrollViewer>
   <DockPanel Grid.Row="3" Margin="0,15,0,0"><Button x:Name="SyncButton" Content="↻  Atualizar" Padding="12,7" FontSize="11" DockPanel.Dock="Right" Click="SyncGoogle" Margin="8,0,0,0"/><TextBlock x:Name="FooterLabel" Text="Pingo está por aqui. Os avisos funcionam com o app aberto." Foreground="#938BA4" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  </Grid>
 </Grid>
</Window>
